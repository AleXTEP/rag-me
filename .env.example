# Copy to .env and fill in. .env is gitignored; this file is not.

# Anthropic API key used by HyDE query expansion (HYDE_PROVIDER=claude).
# Leave empty to fall back to the SDK default (ANTHROPIC_API_KEY).
HYDE_API_KEY=

# Optional overrides - defaults live in config.py
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# USE_ELASTICSEARCH=true
# CHUNKING_STRATEGY=fixed
# EXTRACTION_BACKEND=pymupdf
# OCR_PROVIDER=tesseract
